NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# PostgreSQL (required)
DATABASE_URL=postgresql://drawbay:change-this@localhost:5432/drawbay
DATABASE_SSL=false
DB_POOL_SIZE=10
DB_PASSWORD=replace-with-a-long-random-database-password

# Generate a random secret with at least 32 characters; use a different value in production.
JWT_SECRET=replace-with-a-long-random-secret-value
ADMIN_NAME=Guaranteed Impressions Administrator
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=replace-with-at-least-16-random-characters

# Paystack secret key. Use a live key only in production.
PAYSTACK_SECRET_KEY=sk_test_replace_me
ENABLE_COMMERCE=false

# Resend transactional email
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Guaranteed Impressions <accounts@example.com>

# Private S3-compatible bucket (AWS S3, Cloudflare R2, or compatible service)
S3_BUCKET=drawbay-private
S3_REGION=eu-west-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Frontend is same-origin in production; this is only used when running Vite separately.
VITE_API_BASE=/api
