{
 "name": "drawbay-frontend",
 "private": true,
 "version": "0.1.0",
 "type": "module",
 "scripts": {
  "setup": "npm install",
  "dev": "concurrently -n web,api -c yellow,cyan \"vite\" \"node --env-file-if-exists=.env --watch server/index.js\"",
  "web": "vite",
  "api": "node --env-file-if-exists=.env server/index.js",
  "start": "node --env-file-if-exists=.env server/index.js",
  "build": "tsc --noEmit && vite build",
  "typecheck": "tsc --noEmit",
  "preview": "vite preview"
 },
 "dependencies": {
  "@aws-sdk/client-s3": "^3.850.0",
  "@aws-sdk/s3-request-presigner": "^3.850.0",
  "express-rate-limit": "^7.5.1",
  "helmet": "^8.1.0",
  "pg": "^8.16.3",
  "react": "^18.3.1",
  "react-dom": "^18.3.1",
  "react-router-dom": "^6.26.0",
  "express": "^4.19.2",
  "cors": "^2.8.5",
  "jsonwebtoken": "^9.0.2"
 },
 "devDependencies": {
  "@types/react": "^18.3.3",
  "@types/react-dom": "^18.3.0",
  "@vitejs/plugin-react": "^4.3.1",
  "typescript": "^5.5.4",
  "vite": "^5.4.0",
  "concurrently": "^8.2.2"
 }
}
